{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "950px",
      "wideSize": "1280px"
    },
    "dimensions": {
      "aspectRatio": true,
      "minHeight": true
    },
    "spacing": {
      "blockGap": true,
      "customSpacingSize": true,
      "padding": true,
      "margin": true,
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "spacingSizes": [
        {
          "name": "XS",
          "slug": "xs",
          "size": "0.5rem"
        },
        {
          "name": "S",
          "slug": "s",
          "size": "1rem"
        },
        {
          "name": "M",
          "slug": "m",
          "size": "1.5rem"
        },
        {
          "name": "L",
          "slug": "l",
          "size": "2.5rem"
        },
        {
          "name": "XL",
          "slug": "xl",
          "size": "4rem"
        },
        {
          "name": "2XL",
          "slug": "2-xl",
          "size": "6rem"
        }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "position": {
      "sticky": true
    },
    "typography": {
      "customFontSize": true,
      "lineHeight": true,
      "fluid": true,
      "fontSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "0.875rem",
          "fluid": { "min": "0.8125rem", "max": "0.9375rem" }
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "1rem",
          "fluid": { "min": "1rem", "max": "1.125rem" }
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "1.5rem",
          "fluid": { "min": "1.25rem", "max": "1.75rem" }
        },
        {
          "name": "X-Large",
          "slug": "x-large",
          "size": "2rem",
          "fluid": { "min": "1.625rem", "max": "2.25rem" }
        },
        {
          "name": "XX-Large",
          "slug": "xx-large",
          "size": "2.75rem",
          "fluid": { "min": "2.125rem", "max": "3.25rem" }
        },
        {
          "name": "Huge",
          "slug": "huge",
          "size": "3.75rem",
          "fluid": { "min": "2.75rem", "max": "4.5rem" }
        }
      ]
    },
    "color": {
      "background": true,
      "button": true,
      "caption": true,
      "custom": true,
      "customDuotone": true,
      "customGradient": true,
      "defaultGradients": true,
      "heading": true,
      "link": true,
      "text": true,
      "gradients": [
        {
          "name": "AJNanda: Primary to Dark",
          "slug": "ajnanda-primary-to-dark",
          "gradient": "linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%)"
        },
        {
          "name": "AJNanda: Primary to Secondary",
          "slug": "ajnanda-primary-to-secondary",
          "gradient": "linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%)"
        },
        {
          "name": "AJNanda: Dark to Dim",
          "slug": "ajnanda-dark-to-dim",
          "gradient": "linear-gradient(135deg, var(--primary-dark) 0%, var(--gray-900) 100%)"
        },
        {
          "name": "AJNanda: Primary Glow",
          "slug": "ajnanda-primary-glow",
          "gradient": "radial-gradient(circle, var(--primary) 0%, var(--primary-dark) 100%)"
        }
      ],
      "palette": [
        {
          "name": "Primary Blue",
          "slug": "primary-blue",
          "color": "#2563eb"
        },
        {
          "name": "Deep Blue",
          "slug": "deep-blue",
          "color": "#1e40af"
        },
        {
          "name": "Purple",
          "slug": "purple",
          "color": "#7c3aed"
        },
        {
          "name": "Gold",
          "slug": "gold",
          "color": "#f59e0b"
        },
        {
          "name": "Ink",
          "slug": "ink",
          "color": "#111827"
        },
        {
          "name": "Soft Gray",
          "slug": "soft-gray",
          "color": "#f3f4f6"
        },
        {
          "name": "White",
          "slug": "white",
          "color": "#ffffff"
        }
      ]
    }
  },
  "styles": {
    "elements": {
      "button": {
        "border": {
          "radius": "0.5rem"
        },
        "color": {
          "background": "var(--primary)",
          "text": "#ffffff"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "right": "1.5rem",
            "bottom": "0.75rem",
            "left": "1.5rem"
          }
        },
        "typography": {
          "fontWeight": "600"
        }
      }
    }
  }
}
